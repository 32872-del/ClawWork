# General runtime switches
PYTHONUNBUFFERED=1
HEADLESS=1
BATCH=2
WAIT=1

# Shared proxy credentials. Keep real values only in your local .env or shell.
BRIGHT_USE_PROXY=0
BRIGHT_PROXY_URL=
BRIGHT_PROXY_COUNTRY=
BRIGHT_PROXY_MIN_ROTATE_SECONDS=180

# Site-specific proxy examples
TEAMS_USE_PROXY=0
TEAMS_PROXY_URL=
CHAUSSEA_USE_PROXY=0
CHAUSSEA_PROXY_URL=

# Site cookies / auth tokens. Paste browser cookies locally when a site needs them.
BABYSHOP_COOKIE=
OBI_COOKIE=
HOMECENTRE_COOKIE=
CHAUSSEA_COOKIE=
LUVISHOES_COOKIE=
TAKISTIR_COOKIE=

# Useful collection limits for testing
BABYSHOP_MAX_CATEGORIES=0
BABYSHOP_MAX_PAGES=0
BABYSHOP_MAX_PRODUCTS=0
OBI_MAX_CATEGORIES=0
OBI_MAX_PAGES=0
OBI_MAX_PRODUCTS=0
